# Copy to .env and fill in. Never commit .env.
OPENROUTER_API_KEY=sk-or-v1-...
# Free models, tried in order (OpenRouter falls back server-side). Check current free
# tool-calling models at https://openrouter.ai/models?max_price=0&supported_parameters=tools
OPENROUTER_MODELS=openrouter/free
# Domain Traefik routes to this app (DNS A record must point at the VPS)
APP_DOMAIN=chat.example.com
MAX_MESSAGES_PER_SESSION=30

# Optional: Langfuse tracing (leave empty to disable). Keys: Langfuse project > Settings > API Keys
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=production
